{
  "name": "songgame",
  "version": "1.0.0",
  "private": true,
  "description": "A party game where everyone adds songs to a shared Spotify playlist",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hensage/songgame.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Hensage/songgame/issues"
  },
  "homepage": "https://github.com/Hensage/songgame#readme",
  "dependencies": {
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^6.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2",
    "vite": "^8.3.8"
  }
}
